# Copier ce fichier vers .env puis renseigner les valeurs réelles.
# .env n'est jamais versionné (voir .gitignore) ; .env.example ne doit
# jamais contenir de vraie valeur (jeton, identifiant de ressource privée).

# Étapes 2 et 5 (Phase 2) — appels à l'API Anthropic.
# Créer une clé sur la Console Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Étape 7 — voir docs/etape-7-stockage-diagbruit.md
# Jeton d'intégration Notion (interne), partagé avec la base "Données
# réglementaires locales (PLU, PPBE, ...)" depuis Notion : Paramètres > Connexions.
PERSONNAL_NOTION_TOKEN=ntn_...
# Identifiant de cette base Notion (32 caractères hexadécimaux, avec ou sans
# tirets), tiré de son URL.
NOTION_DATABASE_ID=...

# Étape 7 — jeton d'API Strapi (préprod) avec droit d'écriture sur le
# content-type noisezone-alert, et URL de base de ce Strapi préprod (voir
# fastapi/.env.example pour la variable équivalente en local :
# STRAPI_URL=http://localhost:1337).
STRAPI_API_TOKEN=...
STRAPI_URL=...
