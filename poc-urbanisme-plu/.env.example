# Copier ce fichier vers .env puis renseigner les valeurs réelles.
# .env n'est jamais versionné (voir .gitignore) ; .env.example ne doit
# jamais contenir de vraie valeur (jeton, identifiant de ressource privée).

# Étapes 2 et 5 (Phase 2) — appels à l'API Anthropic.
# Créer une clé sur la Console Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Étape 7 — voir docs/etape-7-stockage-diagbruit.md
# Jeton d'intégration Notion (interne), partagé avec la base "Données
# réglementaires locales (PLU, PPBE, ...)" depuis Notion : Paramètres > Connexions.
PERSONNAL_NOTION_TOKEN=ntn_...
# Identifiant de cette base Notion (32 caractères hexadécimaux, avec ou sans
# tirets), tiré de son URL.
NOTION_DATABASE_ID=...

# Étape 7 — jeton d'API Strapi préprod avec droit d'écriture sur le
# content-type noisezone-alert, et URL de base de ce Strapi préprod (voir
# fastapi/.env.example pour la variable équivalente en local :
# STRAPI_URL=http://localhost:1337). Utilisées par défaut par `inserer.py`
# (`--environnement preprod`, valeur par défaut — voir
# docs/etape-7-conception-technique.md).
STRAPI_PREPROD_API_TOKEN=...
STRAPI_PREPROD_URL=...

# Étape 7 — mêmes droits que ci-dessus, sur le Strapi de production. Utilisées
# par `inserer.py --environnement prod` — jamais le défaut, à ne renseigner
# qu'une fois prêt à écrire en production.
STRAPI_PROD_API_TOKEN=...
STRAPI_PROD_URL=...

# Étape 7 — dépôt des géométries sur Box avant liaison à Notion (voir
# docs/etape-7-stockage-diagbruit.md, "Pièce jointe géométrie"). Application
# Box en Client Credentials Grant, à l'échelle entreprise (BOX_ENTREPRISE_ID =
# l'enterprise ID Box) — même mécanisme et mêmes noms de variables que
# dagster/.env.example (composant indépendant, credentials à renseigner
# séparément ici).
BOX_CLIENT_ID=...
BOX_CLIENT_SECRET=...
BOX_ENTREPRISE_ID=...
